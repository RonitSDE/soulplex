# Copy to .env for the production compose file; never commit it.
# Local runs keep data in a SQLite file. Production compose uses Postgres.
DOMAIN=soulplex.your-domain.example
APP_ORIGIN=https://soulplex.your-domain.example
# Use a long random alphanumeric password (avoids URL encoding issues).
POSTGRES_PASSWORD=replace_with_random_48_character_password
# Required for live verification and recovery. Configure a real delivery domain.
SMTP_HOST=
SMTP_FROM=accounts@your-domain.example
SMTP_USERNAME=
SMTP_PASSWORD=

# Live mode uses this key for safety screening.
AI_API_KEY=
# Hello Minds. Server secret only. Never put it in frontend code.
# Create it in the Builder console (shown once): https://build.hellominds.ai
MINDS_BUILDER_API_KEY=
# Archetype for a new agent. Examples: mastermind, gtm.
MINDS_MIND_TYPE=mastermind
# A connection is offered only when the date score reaches this (0-100).
MATCH_SCORE_MIN=70